{
  "name": "klinch",
  "version": "0.1.0",
  "description": "AI-powered SDR interview coach",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "node scripts/generate-build-config.js && electron-builder",
    "build:win": "node scripts/generate-build-config.js && electron-builder --win",
    "release": "node scripts/generate-build-config.js && electron-builder --mac --win --publish always",
    "release:mac": "node scripts/generate-build-config.js && electron-builder --mac --publish always",
    "release:win": "node scripts/generate-build-config.js && electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.klinch.app",
    "productName": "Klinch",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "Klinch-App",
      "repo": "klinch"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Klinch-App/klinch"
  },
  "author": "Sean Egan <sean@tryklinch.com>",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.3",
    "@supabase/supabase-js": "^2.105.3",
    "dotenv": "^16.4.7",
    "electron-updater": "^6.8.3",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "stripe": "^22.1.1"
  }
}
