{
  "name": "klinch",
  "version": "0.1.0",
  "description": "AI-powered SDR interview coach",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.klinch.app",
    "productName": "Klinch",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      { "from": ".env", "to": ".env" }
    ],
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    }
  },
  "author": "Sean Egan <sean@tryklinch.com>",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.3",
    "@supabase/supabase-js": "^2.105.3",
    "dotenv": "^16.4.7",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "stripe": "^22.1.1"
  }
}
